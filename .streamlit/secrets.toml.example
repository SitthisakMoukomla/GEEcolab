# ---------------------------------------------------------------------
# Streamlit Secrets Template
# ---------------------------------------------------------------------
# คัดลอกไฟล์นี้ไปใส่ที่ Streamlit Community Cloud:
#   https://share.streamlit.io → App → Settings → Secrets
#
# ห้าม commit ไฟล์นี้ที่มีค่าจริงเข้า Git!
# (.streamlit/secrets.toml ถูก ignore ใน .gitignore แล้ว)
# ---------------------------------------------------------------------

# 1) GCP project ที่เปิด Earth Engine API ไว้
GEE_PROJECT_ID = "your-gcp-project-id"

# 2) JSON key ของ service account ทั้งก้อน (stringified)
#    - ต้อง register service account กับ GEE:
#      https://code.earthengine.google.com/register
#    - ต้องให้สิทธิ์ Earth Engine Resource Viewer บน IAM
GEE_SERVICE_ACCOUNT_JSON = """
{
  "type": "service_account",
  "project_id": "your-gcp-project-id",
  "private_key_id": "abc123...",
  "private_key": "-----BEGIN PRIVATE KEY-----\\nMIIE...\\n-----END PRIVATE KEY-----\\n",
  "client_email": "streamlit-gee@your-gcp-project-id.iam.gserviceaccount.com",
  "client_id": "1234567890",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "https://www.googleapis.com/robot/v1/metadata/x509/streamlit-gee%40your-gcp-project-id.iam.gserviceaccount.com",
  "universe_domain": "googleapis.com"
}
"""
